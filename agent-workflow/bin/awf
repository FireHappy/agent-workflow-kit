#!/usr/bin/env bash
# awf — agent workflow framework
#
# 在空项目（或已有仓库）中生成一套与 harness 无关的 agent 工作流框架：
#   agent-workflow/ 状态账本 + 流程规范 + 校验工具
#   AGENTS.md       仓库根入口（生成物，不属于工作流目录）
#
# 兼容 bash 3.2（macOS 自带），仅依赖 POSIX 工具。
set -eu

AWF_VERSION="1"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TPL_DIR="$KIT_DIR/templates"

say() { printf '%s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
die() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

today() { date '+%Y-%m-%d'; }
now() { date '+%Y-%m-%d %H:%M'; }

# awk 包装（DEV-117）：统一以 LC_ALL=C 调用，避免 macOS awk 20200816 在
# en_US.UTF-8 等 UTF-8 locale 下多字节中文 `==` 字符串比较恒真（实测
# "状态"=="字段" → 1），导致账本字段名误判（如把 `| 证伪方法 | z |` 的 z 当
# 状态 → check 报「状态非法：z」）。LC_ALL=C 使字符串比较退回字节语义，中文
# 不再互相误等；输出字节原样透传，UTF-8 内容不受影响（本文件 awk 均为 ASCII
# 锚点 + 字面替换，无字符级截断中文的依赖，C locale 下行为一致）。
awfk() {
  LC_ALL=C awk "$@"
}

hash_files() {
  if command -v shasum >/dev/null 2>&1; then
    cat "$@" | shasum -a 256 | awfk '{print substr($1,1,8)}'
  else
    cat "$@" | sha256sum | awfk '{print substr($1,1,8)}'
  fi
}

slug() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//'
}

yaml_get() {
  local key="$1" file="$2"
  # 只取「有值」的匹配行：跳过空值键行（如模板曾预置的空 `role: ` 行），
  # 保证重复键时取第一个有值项（DEV-119，旧项目双 role 键兼容）。
  sed -n "s/^${key}:[[:space:]]*//p" "$file" \
    | grep -v '^[[:space:]]*$' \
    | head -n 1 \
    | sed 's/[[:space:]]*$//'
}

# worker 名牌（DEV-118/119）：读项目 project.yaml 的 role 字段（一句话自述）；
# 缺省回退到 name，再缺省输出 `-`。只读，不改索引（yaml 为单一事实源）。
project_role() {
  local y="$1/agent-workflow/project.yaml" r n
  if [ -f "$y" ]; then
    r="$(yaml_get role "$y")"
    n="$(yaml_get name "$y")"
  fi
  r="$(printf '%s' "$r" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"   # 判空前置 trim
  if [ -n "$r" ]; then printf '%s\n' "$r"
  elif [ -n "$n" ]; then printf '%s\n' "$n"
  else printf '%s\n' '-'
  fi
}

usage() {
  cat <<'EOF'
awf — agent workflow framework

用法:
  awf init [目录] [--name 名称] [--id 标识] [--purpose 一句话] [--role 能力自述] [--stack 类型]
           [--keep-docs] [--force]
      在目标目录生成 agent-workflow/ 框架与仓库根 AGENTS.md。
      --role 能力自述（一句话）写入 project.yaml 的 role 字段作为 worker 名牌，
             init 即带能力定义；缺省保留空 role 键，可稍后在 project.yaml 补充。
      --keep-docs  已存在的 README.md 与 workflows/*.md 不覆盖（迁移旧项目用）。
      --no-register 不写入全局索引（默认自动登记，便于跨项目检索）。

  awf bootstrap
      按当前 project.yaml 重建 AGENTS.md 受控区块（只替换区块，不动其他内容）。
      若项目已在全局索引中，会顺带刷新其路径与别名。

  awf check [--with-smoke]
      校验框架完整性、AGENTS.md 入口新鲜度、进行中任务的必填字段、
      status.md 新鲜度、done.md 归档块与生成副本漂移（kit 仓库）。
      状态枚举只允许 active/blocked/review/verify/handoff。
      --with-smoke：check 全过后追加运行 bash test/smoke.sh（有 test/smoke.sh
      时；无则跳过），把冒烟并入日常门禁。默认只在末尾提示「请跑 smoke」。

  awf install-hooks [--check | --uninstall]
      git pre-commit 钩子管理（日常门禁）：安装/检查/卸载 .git/hooks/pre-commit
      ——提交前自动运行 ./agent-workflow/check_workflow.sh，非零即拒绝提交并输出
      中文提示。模板来自 templates/pre-commit（kit）或
      agent-workflow/templates/pre-commit（由 awf upgrade 复制）；需在 git 仓库内的
      agent-workflow 项目中执行。钩子不入库、不 push、不自动卸载。

  awf status
      从 tasks/*/current.md、todo.md、done.md 生成 tasks/status.md。

  awf register
      把当前项目登记到全局索引（~/.agents/projects.tsv 与 AGENTS.md）。

  awf projects
      打印已登记的项目（别名 → 路径 → 角色；角色来自各项目 project.yaml 的
      role 字段即 worker 名牌，缺省回退到 name）。

  awf find <别名|ID>
      按别名或 ID 查找项目路径；输出 `id\t路径\t角色`（角色缺省回退 name）。

  awf release-prep <X.Y.Z> [--root 目录] [--dry-run]
      一键发版装配：先检测生成副本漂移（bin/awf / bin/awf-dispatch /
      templates/ ↔ agent-workflow/），有漂移即拒绝覆盖；无漂移才刷新生成副本
      与 AGENTS 入口、写账本、改 VERSION/CHANGELOG、跑校验并归档；
      只打印下一步 git 命令，不自动 commit/tag/push。

  awf upgrade [目录] [--dry-run] [--force]
      升级已有项目的 agent-workflow 框架到当前 kit 版本（一等操作）：
      复制框架文件（bin/awf、bin/awf-dispatch、templates/AGENTS.md.tmpl、
      README.md、workflows/*.md、check_workflow.sh 兼容入口）→ bootstrap
      刷新 AGENTS.md 入口 → check 校验；保留 project.yaml、tasks/**、
      memory/**、tools/** 与账本历史。旧账本格式问题（归档块缺「状态」、
      旧英文表头 | Status |）由 check 输出修复指引。
      详细步骤与验收见 docs/upgrade.md。

  awf-dispatch <别名|目录> <任务文件>
      跨项目派发（DSH 会话适配）：检查目标工作流/工作区后，在目标工作区创建会话执行。
      另见 docs/dispatch.md 与 agent-workflow/workflows/cross-project.md。

说明:
  init 之后请编辑 agent-workflow/project.yaml，再运行 awf bootstrap。
  check 的退出码 = 失败项数量，可直接用于 pre-commit / CI（install-hooks 已内置）。
EOF
}

# ---------------------------------------------------------------- 项目根发现

find_root() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    if [ -f "$d/agent-workflow/project.yaml" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

# ---------------------------------------------------------------- 模板渲染

# 使用调用方设置的 P_* 变量渲染模板；字面替换，不受正则或 & 影响。
render() {
  local tpl="$1" out="$2"
  awfk \
    -v v_id="$P_ID" \
    -v v_name="$P_NAME" \
    -v v_purpose="$P_PURPOSE" \
    -v v_role="$P_ROLE" \
    -v v_aliases="$P_ALIASES" \
    -v v_stack="$P_STACK" \
    -v v_gate="$P_GATE" \
    -v v_compile="$P_COMPILE" \
    -v v_test="$P_TEST" \
    -v v_scopes="$P_SCOPES" \
    -v v_serialized="$P_SERIALIZED" \
    -v v_digest="$P_DIGEST" \
    -v v_version="$AWF_VERSION" \
    -v v_date="$(today)" '
    function rep(s, k, v,   out, i) {
      out = ""
      while ((i = index(s, k)) > 0) {
        out = out substr(s, 1, i - 1) v
        s = substr(s, i + length(k))
      }
      return out s
    }
    {
      l = $0
      l = rep(l, "{{ID}}", v_id)
      l = rep(l, "{{NAME}}", v_name)
      l = rep(l, "{{PURPOSE}}", v_purpose)
      l = rep(l, "{{ROLE}}", v_role)
      l = rep(l, "{{ALIASES}}", v_aliases)
      l = rep(l, "{{STACK}}", v_stack)
      l = rep(l, "{{GATE}}", v_gate)
      l = rep(l, "{{COMPILE}}", v_compile)
      l = rep(l, "{{TEST}}", v_test)
      l = rep(l, "{{SCOPES}}", v_scopes)
      l = rep(l, "{{SERIALIZED}}", v_serialized)
      l = rep(l, "{{DIGEST}}", v_digest)
      l = rep(l, "{{VERSION}}", v_version)
      l = rep(l, "{{DATE}}", v_date)
      print l
    }
  ' "$tpl" > "$out"
}

load_project() {
  local f="$1" tpl
  [ -f "$f" ] || die "缺少 $f"

  P_ID="$(yaml_get id "$f")"
  P_NAME="$(yaml_get name "$f")"
  P_PURPOSE="$(yaml_get purpose "$f")"
  P_ALIASES="$(yaml_get aliases "$f")"
  P_STACK="$(yaml_get stack "$f")"
  P_GATE="$(yaml_get gate "$f")"
  P_COMPILE="$(yaml_get compile "$f")"
  P_TEST="$(yaml_get test "$f")"
  P_SCOPES="$(yaml_get scopes "$f")"
  P_SERIALIZED="$(yaml_get serialized "$f")"
  P_ROLE="$(yaml_get role "$f")"

  [ -n "$P_ID" ] || die "$f 缺少 id"
  [ -n "$P_NAME" ] || die "$f 缺少 name"

  # 入口里展示“未配置”，但 project.yaml 本身保持空值，避免把占位文字当命令执行
  [ -n "$P_PURPOSE" ] || P_PURPOSE="$P_NAME 项目"
  [ -n "$P_ALIASES" ] || P_ALIASES="$P_NAME"
  [ -n "$P_GATE" ] || P_GATE="./agent-workflow/check_workflow.sh"
  [ -n "$P_COMPILE" ] || P_COMPILE="（未配置，见 agent-workflow/project.yaml）"
  [ -n "$P_TEST" ] || P_TEST="（未配置，见 agent-workflow/project.yaml）"
  [ -n "$P_SCOPES" ] || P_SCOPES="主工程(.)"
  [ -n "$P_SERIALIZED" ] || P_SERIALIZED="无"

  tpl="$(dirname "$f")/templates/AGENTS.md.tmpl"
  if [ -f "$tpl" ]; then
    P_DIGEST="$(hash_files "$f" "$tpl")"
  else
    P_DIGEST="$(hash_files "$f")"
  fi
}

# 只替换 <!-- awf:begin --> 与 <!-- awf:end --> 之间；无标记则追加。
write_agents() {
  local root="$1" block="$2" f="$1/AGENTS.md"

  if [ ! -f "$f" ]; then
    cp "$block" "$f"
    return 0
  fi

  if grep -q '<!-- awf:begin' "$f"; then
    local nb ne
    nb="$(grep -c '<!-- awf:begin' "$f" || true)"
    ne="$(grep -c '<!-- awf:end' "$f" || true)"
    if [ "$nb" != "$ne" ] || [ "$nb" -gt 1 ]; then
      die "AGENTS.md 受控区块不完整（begin $nb / end ${ne}）：请手工补成一对 <!-- awf:begin --> … <!-- awf:end --> 后重试；本次未改写文件"
    fi
    awfk -v bf="$block" '
      BEGIN { while ((getline l < bf) > 0) blk = blk l "\n" }
      /<!-- awf:begin/ { printf "%s", blk; skip = 1; next }
      /<!-- awf:end/   { skip = 0; next }
      !skip { print }
    ' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  else
    { printf '\n'; cat "$block"; } >> "$f"
  fi
}

# ---------------------------------------------------------------- init

detect_stack() {
  local d="$1"
  if [ -f "$d/Cargo.toml" ]; then echo rust
  elif [ -f "$d/go.mod" ]; then echo go
  elif [ -f "$d/package.json" ]; then echo node
  elif [ -f "$d/pom.xml" ]; then echo maven
  elif [ -f "$d/gradlew" ] || [ -f "$d/build.gradle" ] || [ -f "$d/build.gradle.kts" ]; then echo gradle
  elif [ -d "$d/Assets" ] && [ -d "$d/ProjectSettings" ]; then echo unity
  else echo generic
  fi
}

default_verify() {
  case "$1" in
    rust)   echo "cargo build|cargo test" ;;
    go)     echo "go build ./...|go test ./..." ;;
    node)   echo "npm run build|npm test" ;;
    maven)  echo "./mvnw -q package|./mvnw -q test" ;;
    gradle) echo "./gradlew build|./gradlew test" ;;
    *)      echo "|" ;;
  esac
}

put_if_absent() {
  local f="$1"
  if [ -f "$f" ]; then
    cat >/dev/null
  else
    cat > "$f"
  fi
}

write_task_files() {
  local dir="$1"

  put_if_absent "$dir/dev/todo.md" <<'EOF'
# 待开发

| 任务ID | 优先级 | 描述 | 登记日期 |
|--------|--------|------|----------|
EOF

  put_if_absent "$dir/debug/todo.md" <<'EOF'
# 待调试

| 任务ID | 优先级 | 问题描述 | 登记日期 |
|--------|--------|----------|----------|
EOF

  put_if_absent "$dir/docs/todo.md" <<'EOF'
# 待撰写

| 任务ID | 优先级 | 文档主题 | 登记日期 |
|--------|--------|----------|----------|
EOF

  put_if_absent "$dir/dev/done.md" <<'EOF'
# 已完成

| 任务ID | 优先级 | 描述 | 完成日期 |
|--------|--------|------|----------|
EOF

  put_if_absent "$dir/debug/done.md" <<'EOF'
# 已完成

| 任务ID | 优先级 | 问题描述 | 完成日期 |
|--------|--------|----------|----------|
EOF

  put_if_absent "$dir/docs/done.md" <<'EOF'
# 已完成

| 任务ID | 优先级 | 文档主题 | 完成日期 |
|--------|--------|----------|----------|
EOF

  put_if_absent "$dir/dev/current.md" <<'EOF'
# 正在开发

> 任务从 `todo.md` 移入此文件开始执行，完成后移入 `done.md`。
> 优先级只写 `P0` / `P1` / `P2` / `P3`。
> `awf status` 会解析本文件，任务块格式必须保持：`## [ID] 标题` + 字段表 + `### 下一步`。

（暂无进行中任务）

<!-- 任务块格式示例（ID 用 XXX 占位，不会被解析）：

## [DEV-XXX] 任务标题

| 字段 | 内容 |
|------|------|
| 优先级 | P1 |
| 状态 | active |
| Owner | agent / human / unassigned |
| 协作模式 | single / parallel |
| 来源任务 | 无 / DEBUG-003 / 用户直接触发 |
| 修改范围 | 模块 / 目录 / 关键文件 |
| 分支/工作区 | 分支名 / worktree 标识 / N/A |
| 依赖 | 无 |
| 最近更新 | YYYY-MM-DD |

### 目标
一句话说明交付什么。

### 验收标准
- [ ] 校验命令通过
- [ ] 目标行为符合预期
- [ ] 没有已知回归

### 下一步
下一位 agent 可直接接手的最小动作。
-->
EOF

  put_if_absent "$dir/debug/current.md" <<'EOF'
# 正在调试

> 问题从 `todo.md` 移入此文件开始排查，解决后移入 `done.md`。
> 每个任务块必须写清：现象、假设、证伪方法、下一步。

（暂无进行中任务）
EOF

  put_if_absent "$dir/docs/current.md" <<'EOF'
# 正在撰写

> 文档任务从 `todo.md` 移入此文件开始撰写，完成后移入 `done.md`。

（暂无进行中任务）
EOF
}

write_aux_files() {
  local root="$1"

  put_if_absent "$root/agent-workflow/memory/README.md" <<'EOF'
# memory 模块

- `cache/`：临时证据、日志片段、待确认结论。超过 7 天应清理或转存。
- `history/`：长期归档，存放完整修复过程与可复用结论。

命名：

```text
cache/   <主题>_<YYYY-MM-DD>.md
history/ <主题>_<YYYY-MM-DD>.md
```

长期任务可在文件内写 `<!-- long-term: true -->` 免于过期清理。
EOF

  put_if_absent "$root/agent-workflow/memory/cache/README.md" <<'EOF'
# cache

临时证据放这里。任务归档时删除或转存到 `../history/`。
EOF

  put_if_absent "$root/agent-workflow/memory/history/README.md" <<'EOF'
# history

长期归档放这里。`tasks/*/done.md` 的归档链接应指向本目录。
EOF

  put_if_absent "$root/agent-workflow/tools/README.md" <<'EOF'
# tools

项目操作手册：构建、测试、调试、分支规范。

只写经过验证、可直接执行的命令；实验记录写 `../memory/`，结论写 `../docs/`。

替换本文件时建议保留三类内容：

1. 构建与验证命令（可直接复制执行）
2. 环境前置条件与已知限制
3. 常见问题与排查入口
EOF

  put_if_absent "$root/agent-workflow/check_workflow.sh" <<'EOF'
#!/bin/sh
# 兼容入口：等价于 agent-workflow/bin/awf check
exec "$(dirname "$0")/bin/awf" check "$@"
EOF
  chmod +x "$root/agent-workflow/check_workflow.sh"
}

cmd_init() {
  local target="." name="" id="" purpose="" role="" stack="" force=0 keep_docs=0 no_register=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    name="$2"; shift 2 ;;
      --name=*)  name="${1#*=}"; shift ;;
      --id)      id="$2"; shift 2 ;;
      --id=*)    id="${1#*=}"; shift ;;
      --purpose) purpose="$2"; shift 2 ;;
      --purpose=*) purpose="${1#*=}"; shift ;;
      --role)    role="$2"; shift 2 ;;
      --role=*)  role="${1#*=}"; shift ;;
      --stack)   stack="$2"; shift 2 ;;
      --stack=*) stack="${1#*=}"; shift ;;
      --keep-docs) keep_docs=1; shift ;;
      --no-register) no_register=1; shift ;;
      --force)   force=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*)        die "未知参数：$1" ;;
      *)         target="$1"; shift ;;
    esac
  done

  if [ ! -f "$TPL_DIR/README.md" ] || [ ! -d "$TPL_DIR/workflows" ]; then
    die "当前 awf 是项目内副本，只能执行 bootstrap / check / status；新建项目请使用全局技能 agent-workflow-scaffold 的 bin/awf"
  fi

  mkdir -p "$target"
  target="$(cd "$target" && pwd)"

  if [ -e "$target/agent-workflow/project.yaml" ] && [ "$force" -ne 1 ]; then
    die "$target 已存在 agent-workflow，如需覆盖请加 --force"
  fi

  local base
  base="$(basename "$target")"
  [ "$base" = "/" ] && base="project"

  [ -n "$name" ] || name="$base"
  [ -n "$id" ] || id="$(slug "$name")"
  [ -n "$id" ] || id="$(slug "$base")"
  [ -n "$id" ] || id="project"
  [ -n "$purpose" ] || purpose="$name 项目"
  [ -n "$stack" ] || stack="$(detect_stack "$target")"

  local verify_pair compile test
  verify_pair="$(default_verify "$stack")"
  compile="${verify_pair%%|*}"
  test="${verify_pair#*|}"

  mkdir -p "$target/agent-workflow/workflows" \
           "$target/agent-workflow/tasks/dev" \
           "$target/agent-workflow/tasks/debug" \
           "$target/agent-workflow/tasks/docs" \
           "$target/agent-workflow/memory/cache" \
           "$target/agent-workflow/memory/history" \
           "$target/agent-workflow/tools" \
           "$target/agent-workflow/bin" \
           "$target/agent-workflow/templates"

  if [ "$keep_docs" -eq 1 ] && [ -f "$target/agent-workflow/README.md" ]; then
    say "skip  已存在，保留：agent-workflow/README.md"
  else
    cp "$TPL_DIR/README.md" "$target/agent-workflow/README.md"
  fi
  local wf wf_dst
  for wf in "$TPL_DIR"/workflows/*.md; do
    wf_dst="$target/agent-workflow/workflows/$(basename "$wf")"
    if [ "$keep_docs" -eq 1 ] && [ -f "$wf_dst" ]; then
      say "skip  已存在，保留：agent-workflow/workflows/$(basename "$wf")"
    else
      cp "$wf" "$wf_dst"
    fi
  done
  cp "$TPL_DIR/AGENTS.md.tmpl" "$target/agent-workflow/templates/AGENTS.md.tmpl"
  if [ -f "$TPL_DIR/pre-commit" ]; then
    cp "$TPL_DIR/pre-commit" "$target/agent-workflow/templates/pre-commit"
  fi
  cp "$KIT_DIR/bin/awf" "$target/agent-workflow/bin/awf"
  chmod +x "$target/agent-workflow/bin/awf"
  if [ -f "$KIT_DIR/bin/awf-dispatch" ]; then
    cp "$KIT_DIR/bin/awf-dispatch" "$target/agent-workflow/bin/awf-dispatch"
    chmod +x "$target/agent-workflow/bin/awf-dispatch"
  else
    warn "未找到 bin/awf-dispatch；目标项目只能手工派发"
  fi

  write_task_files "$target/agent-workflow/tasks"
  write_aux_files "$target"

  P_ID="$id"
  P_NAME="$name"
  P_PURPOSE="$purpose"
  P_ROLE="$role"
  P_ALIASES="$name"
  P_STACK="$stack"
  P_GATE="./agent-workflow/check_workflow.sh"
  P_COMPILE="$compile"
  P_TEST="$test"
  P_SCOPES="主工程(.)"
  P_SERIALIZED="无"
  P_DIGEST="0"

  if [ ! -f "$target/agent-workflow/project.yaml" ]; then
    render "$TPL_DIR/project.yaml.tmpl" "$target/agent-workflow/project.yaml"
  else
    say "skip  已存在，保留：agent-workflow/project.yaml"
  fi

  # 从事实文件重新加载：统一空值回退逻辑，并计算入口 digest
  load_project "$target/agent-workflow/project.yaml"
  render "$TPL_DIR/AGENTS.md.tmpl" "$target/AGENTS.md.block"
  write_agents "$target" "$target/AGENTS.md.block"
  rm -f "$target/AGENTS.md.block"

  if [ ! -f "$target/CLAUDE.md" ]; then
    cat > "$target/CLAUDE.md" <<'EOF'
# CLAUDE.md

本仓库的 agent 协作入口是 [AGENTS.md](AGENTS.md)（由 agent-workflow 生成）。
请按 AGENTS.md 的顺序读取任务账本与工作流；不要在本文件重复定义流程。
EOF
  fi

  (
    cd "$target"
    ./agent-workflow/bin/awf status >/dev/null
  )

  say "已生成工作流框架：$target"
  say ""
  say "  AGENTS.md                    入口（生成物，在工作流目录之外）"
  say "  CLAUDE.md                    Claude Code 指针"
  say "  agent-workflow/"
  say "  ├── project.yaml             项目事实（唯一输入）"
  say "  ├── README.md                规范正文"
  say "  ├── workflows/               dev / debug / docs / review / cross-project / release"
  say "  ├── tasks/                   任务账本（todo/current/done + status）"
  say "  ├── memory/                  cache / history"
  say "  ├── tools/                   操作手册"
  say "  ├── bin/awf                  bootstrap / check / status"
  say "  ├── bin/awf-dispatch         跨项目派发（DSH 会话适配）"
  say "  └── check_workflow.sh        兼容入口"
  say ""
  say "下一步：编辑 agent-workflow/project.yaml，然后运行"
  say "  ./agent-workflow/bin/awf bootstrap"
  say ""

  ( cd "$target" && ./agent-workflow/bin/awf check )

  if [ "$no_register" -eq 0 ] && [ "${AWF_NO_REGISTER:-0}" != "1" ]; then
    if ( cd "$target" && ./agent-workflow/bin/awf register >/dev/null ); then
      say "已写入全局索引：$AGENTS_HOME/AGENTS.md（可用 awf projects / awf find 检索）"
    else
      warn "全局索引写入失败；框架已生成，可稍后运行 ./agent-workflow/bin/awf register"
    fi
  else
    say "已跳过全局索引登记（--no-register）"
  fi

  if [ -z "$role" ]; then
    say "提示：在 agent-workflow/project.yaml 的 role 字段填写本项目的 worker 能力自述（如：擅长…），awf find / awf projects 检索时可见"
  fi
}

# ---------------------------------------------------------------- bootstrap

cmd_bootstrap() {
  local root
  root="$(find_root)" || die "当前目录不在 agent-workflow 项目中"
  cd "$root"

  load_project "agent-workflow/project.yaml"
  local block=".awf-block.tmp"
  render "agent-workflow/templates/AGENTS.md.tmpl" "$block"
  write_agents "$root" "$block"
  rm -f "$block"

  say "已刷新 AGENTS.md 受控区块（digest: ${P_DIGEST}）"

  if is_registered; then
    if write_registration; then
      say "已刷新全局索引：$P_ID → $PWD"
    else
      warn "全局索引刷新失败（不影响本次 bootstrap）"
    fi
  fi
}

# ---------------------------------------------------------------- check

# 校验任务块（mode=current 时状态值必须 ∈ 工作态枚举，下一步必填；
# mode=done 时归档块同解析，状态保留归档时原值不强制枚举，下一步不强制，
# 并额外校验归档表行：ID 格式 + 优先级 P0-P3 + YYYY-MM-DD 完成日期）。
check_current_file() {
  local f="$1" type="$2" mode="${3:-current}"
  awfk -v wf="$type" -v m="$mode" '
    function trim(s) { gsub(/^[ \t]+/, "", s); gsub(/[ \t]+$/, "", s); return s }
    function flush(   miss) {
      if (id == "") return
      miss = ""
      if (!st) miss = miss " 状态"
      if (!ow) miss = miss " Owner"
      if (m == "current" && !nx) miss = miss " 下一步"
      if (miss != "") {
        # FAIL 自解释：迁移类（旧英文表头 / 归档块）给出可直接执行的修复指引
        printf "FAIL  %s [%s] 缺少字段:%s\n", wf, id, miss
        if (!st) {
          if (st_en) printf "      → 修复：旧英文表头 `| Status |` 改为 `| 状态 |`（保留原值，如 `| 状态 | 完成 |`），再跑 awf check\n"
          else if (m == "done") printf "      → 修复：归档块字段表补一行 `| 状态 | <归档时状态> |`（历史归档可写 `完成`），再跑 awf check\n"
          else printf "      → 修复：字段表补一行 `| 状态 | active`\n"
        }
        if (!ow) printf "      → 修复：字段表补一行 `| Owner | <承担者> |`\n"
        if (m == "current" && !nx) printf "      → 修复：补 `### 下一步` 小节\n"
        bad++
      }
      else if (m == "current" && st_v !~ /^(active|blocked|review|verify|handoff)$/) {
        printf "FAIL  %s [%s] 状态非法：%s（应为 active/blocked/review/verify/handoff）\n", wf, id, st_v
        bad++
      }
      else printf "ok    %s [%s] 字段完整\n", wf, id
      id = ""
    }
    incomment { if ($0 ~ /-->/) incomment = 0; next }
    /<!--/ && !/-->/ { incomment = 1; next }
    index($0, "## [") == 1 {
      flush()
      line = substr($0, 5)
      c = index(line, "] ")
      id = substr(line, 1, c - 1)
      if (c == 0 || id !~ /^[A-Z]+-[0-9]+$/) {
        printf "FAIL  %s 任务块 ID 非法：%s（应为 类型-数字，如 DEV-001）\n", wf, (c > 0 ? id : line)
        bad++
        id = ""
        next
      }
      st = 0; ow = 0; nx = 0; st_v = ""; st_en = 0
      next
    }
    /^### *下一步/ { if (id != "") nx = 1 }
    m == "done" && id == "" && $0 ~ /^\|/ {
      if ($0 ~ /^\|[ \t]*-/ || $0 ~ /^\| *任务ID/) next
      rid = trim($2)
      if (rid == "") next
      if (rid !~ /^[A-Z]+-[0-9]+$/) {
        printf "FAIL  %s 归档行 ID 非法：%s（应为 类型-数字，如 DEV-001）\n", wf, rid
        bad++
        next
      }
      okpri = (trim($3) ~ /^P[0-3]$/)
      hasdate = 0
      for (i = 4; i <= NF; i++) if ($i ~ /^ *[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] *$/) hasdate = 1
      if (!okpri || !hasdate) {
        printf "FAIL  %s 归档行格式错：%s（需 优先级 P0-P3 与 YYYY-MM-DD 完成日期）\n", wf, rid
        bad++
      }
    }
    {
      if (id == "") next
      if ($0 !~ /^\|/) next          # 只扫字段表行；正文里引用 `| Status |` 等迁移字样不算字段
      if (trim($2) == "状态") { st = 1; st_v = trim($3) }
      else if (trim($2) == "Status") { st_en = 1 }
      else if (trim($2) == "Owner") ow = 1
    }
    END { flush(); exit (bad > 0 ? 1 : 0) }
  ' FS='|' "$f"
}

# 生成 status 区块内容（含 当前进行中 / 待处理 / 最近完成）到 $1
status_build_block() {
  local block="$1" type f r todo_rows="" r3 done_rows="" r2
  {
    printf '> 本区块由 `agent-workflow/bin/awf status` 生成，请勿手改。\n'
    printf '> 数据来源：`tasks/*/current.md`、`tasks/*/todo.md`、`tasks/*/done.md`。\n\n'

    for type in dev debug docs; do
      f="agent-workflow/tasks/$type/current.md"
      [ -f "$f" ] || continue
      r="$(awfk -F'|' -v wf="$type" '
        function trim(s) { gsub(/^[ \t]+/, "", s); gsub(/[ \t]+$/, "", s); return s }
        function flush() {
          if (id != "") printf "| %s | %s | %s | %s | %s | %s |\n", wf, id, pri, st, ow, title
          id = ""; pri = ""; st = ""; ow = ""; title = ""
        }
        index($0, "## [") == 1 {
          flush()
          line = substr($0, 5)
          c = index(line, "] ")
          id = substr(line, 1, c - 1)
          if (id !~ /^[A-Z]+-[0-9]+$/) { id = ""; next }
          title = substr(line, c + 2)
          next
        }
        {
          if (id == "") next
          if ($0 !~ /^\|/) next      # 只扫字段表行；正文引用 `| Status |` 等字样不算字段
          if (trim($2) == "优先级") pri = trim($3)
          else if (trim($2) == "状态" || trim($2) == "Status") st = trim($3)
          else if (trim($2) == "Owner") ow = trim($3)
        }
        END { flush() }
      ' "$f")"
      if [ -n "$r" ]; then
        if ! grep -q '^## 当前进行中' "$block"; then
          printf '## 当前进行中\n\n' >> "$block"
          printf '| 工作流 | 任务ID | 优先级 | 状态 | Owner | 任务 |\n' >> "$block"
          printf '|--------|--------|--------|------|-------|------|\n' >> "$block"
        fi
        printf '%s\n' "$r" >> "$block"
      fi
    done

    if ! grep -q '^## 当前进行中' "$block"; then
      printf '## 当前进行中\n\n（无）\n' >> "$block"
    fi
    printf '\n' >> "$block"

    printf '## 待处理\n\n' >> "$block"
    for type in dev debug docs; do
      f="agent-workflow/tasks/$type/todo.md"
      [ -f "$f" ] || continue
      r3="$(awfk -F'|' -v wf="$type" '
        function trim(s) { gsub(/^[ \t]+/, "", s); gsub(/[ \t]+$/, "", s); return s }
        function pick_date(   i) {
          for (i = 2; i < NF; i++) if ($i ~ /^ *[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] *$/) return trim($i)
          return trim($(NF - 1))
        }
        {
          id = trim($2)
          if (id !~ /^[A-Z]+-[0-9]+$/) next
          printf "| %s | %s | %s | %s | %s |\n", wf, id, trim($3), trim($4), pick_date()
        }
      ' "$f")"
      if [ -n "$r3" ]; then
        todo_rows="$todo_rows$r3"$'\n'
      fi
    done
    if [ -z "$todo_rows" ]; then
      printf '（无）\n' >> "$block"
    else
      printf '| 工作流 | 任务ID | 优先级 | 描述 | 登记日期 |\n' >> "$block"
      printf '|--------|--------|--------|------|----------|\n' >> "$block"
      printf '%s' "$todo_rows" >> "$block"
    fi
    printf '\n' >> "$block"

    printf '## 最近完成\n\n' >> "$block"
    for type in dev debug docs; do
      f="agent-workflow/tasks/$type/done.md"
      [ -f "$f" ] || continue
      # 取该类型全部归档行（不做 tail 截断），排序在汇总后统一做：
      # 日期倒序优先，同日按文件出现顺序倒序（越晚归档越靠前）。
      # 记录格式：seq|wf|id|prio|desc|date；date = 行内第一个 YYYY-MM-DD（兼容 4/5/6 列 + 链接列）。
      r2="$(grep -nE '^\| *[A-Z]+-[0-9]+' "$f" | awfk -F'|' -v wf="$type" '
        function trim(s) { gsub(/^[ \t]+/, "", s); gsub(/[ \t]+$/, "", s); return s }
        {
          seq = $1
          sub(/^[0-9]+:/, "", $0)
          if (match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/)) date = substr($0, RSTART, RLENGTH)
          else next
          nf = split($0, parts, "|")
          id = trim(parts[2]); prio = trim(parts[3]); desc = trim(parts[4])
          printf "%s|%s|%s|%s|%s|%s\n", seq, wf, id, prio, desc, date
        }
      ')"
      if [ -n "$r2" ]; then
        done_rows="$done_rows$r2"$'\n'
      fi
    done
    if [ -z "$done_rows" ]; then
      printf '（无）\n' >> "$block"
    else
      printf '| 工作流 | 任务ID | 优先级 | 描述 | 完成日期 |\n' >> "$block"
      printf '|--------|--------|--------|------|----------|\n' >> "$block"
      # 排序：日期（第6字段）倒序 → 行号（第1字段）倒序；取前 8 条，输出规格化行
      printf '%s' "$done_rows" | sort -t'|' -k6,6r -k1,1nr \
        | head -n 8 \
        | awfk -F'|' -v wf='' '{ printf "| %s | %s | %s | %s | %s |\n", $2, $3, $4, $5, $6 }' >> "$block"
    fi

    printf '\n*最后更新：%s*\n' "$(now)" >> "$block"
  } > "$block"
}

# 校验 status.md 新鲜度：临时重渲染状态摘要并与现有文件 diff（忽略 最后更新 行）
check_status_fresh() {
  local block
  block=".awf-status-fresh.tmp"
  [ -f "agent-workflow/tasks/status.md" ] || return 0   # 缺失已由 required 计失败
  status_build_block "$block"
  local gen act
  gen="$(grep -v '最后更新' "$block" || true)"
  act="$(sed -n '/<!-- awf:status:begin -->/,/<!-- awf:status:end -->/p' agent-workflow/tasks/status.md \
    | sed '1d;$d' | grep -v '最后更新' || true)"
  rm -f "$block"
  if [ "$gen" = "$act" ]; then
    say "ok    tasks/status.md 与账本一致（新鲜）"
    return 0
  fi
  say "FAIL  tasks/status.md 已过期（账本改动后未刷新）"
  say "      → 运行 ./agent-workflow/bin/awf status"
  return 1
}

# 生成副本漂移报告（kit 形态：根目录同时有 bin/awf 与 templates/ 时生效）。
# 返回 0=无漂移；非 0=存在漂移；stdout 逐对打印 ok / FAIL 明细。
copy_drift_report() {
  local root="$1" rc=0 pair src dst wf b
  if [ ! -f "$root/bin/awf" ] || [ ! -f "$root/templates/README.md" ] || [ ! -d "$root/templates/workflows" ]; then
    return 0
  fi
  for pair in "bin/awf:agent-workflow/bin/awf" \
              "bin/awf-dispatch:agent-workflow/bin/awf-dispatch" \
              "templates/README.md:agent-workflow/README.md" \
              "templates/AGENTS.md.tmpl:agent-workflow/templates/AGENTS.md.tmpl"; do
    src="${pair%%:*}"; dst="${pair#*:}"
    [ -f "$root/$src" ] || continue
    if [ ! -f "$root/$dst" ]; then
      say "FAIL  生成副本缺失：$root/${dst}（源 $root/${src}）"
      rc=1
    elif ! cmp -s "$root/$src" "$root/$dst"; then
      say "FAIL  生成副本漂移：$src ≠ $dst"
      say "      → 同步 agent-workflow/ 对应文件，或运行 ./bin/awf init . --force --no-register 有意刷新（会覆盖 agent-workflow 侧改动）"
      rc=1
    else
      say "ok    $src 与 $dst 副本一致"
    fi
  done
  for wf in "$root"/templates/workflows/*.md; do
    [ -f "$wf" ] || continue
    b="$(basename "$wf")"
    if [ ! -f "$root/agent-workflow/workflows/$b" ]; then
      say "FAIL  生成副本缺失：$root/agent-workflow/workflows/${b}（源 ${wf}）"
      rc=1
    elif ! cmp -s "$wf" "$root/agent-workflow/workflows/$b"; then
      say "FAIL  生成副本漂移：templates/workflows/$b ≠ agent-workflow/workflows/$b"
      say "      → 同步 agent-workflow/ 对应文件，或运行 ./bin/awf init . --force --no-register 有意刷新（会覆盖 agent-workflow 侧改动）"
      rc=1
    else
      say "ok    templates/workflows/$b 与 agent-workflow/workflows/$b 副本一致"
    fi
  done
  return "$rc"
}

cmd_check() {
  local with_smoke=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --with-smoke) with_smoke=1; shift ;;
      -h|--help)
        say "用法：awf check [--with-smoke]" \
             "  --with-smoke   check 全过后追加运行 bash test/smoke.sh（有则跑，无则跳过）"
        return 0 ;;
      *) die "未知参数：$1（用法：awf check [--with-smoke]）" ;;
    esac
  done

  local root fails=0 out f
  root="$(find_root)" || die "当前目录不在 agent-workflow 项目中（找不到 agent-workflow/project.yaml）"
  cd "$root"

  local required="
AGENTS.md
agent-workflow/project.yaml
agent-workflow/README.md
agent-workflow/workflows/dev.md
agent-workflow/workflows/debug.md
agent-workflow/workflows/docs.md
agent-workflow/workflows/review.md
agent-workflow/workflows/cross-project.md
agent-workflow/workflows/release.md
agent-workflow/tasks/status.md
agent-workflow/templates/AGENTS.md.tmpl
agent-workflow/tasks/dev/done.md
agent-workflow/tasks/debug/done.md
agent-workflow/tasks/docs/done.md
"
  for f in $required; do
    if [ -f "$f" ]; then
      say "ok    $f"
    else
      say "FAIL  缺少 $f"
      fails=$((fails + 1))
    fi
  done

  local nb ne
  nb="$(grep -c '<!-- awf:begin' AGENTS.md || true)"
  ne="$(grep -c '<!-- awf:end' AGENTS.md || true)"
  if [ "$nb" = "1" ] && [ "$ne" = "1" ]; then
    say "ok    AGENTS.md 受控区块标记成对"
  else
    say "FAIL  AGENTS.md 受控区块标记不成对（begin $nb / end ${ne}）"
    fails=$((fails + 1))
  fi

  local actual recorded
  actual="$(hash_files agent-workflow/project.yaml agent-workflow/templates/AGENTS.md.tmpl)"
  recorded="$(sed -n 's/.*<!-- awf:begin v[0-9][0-9]* digest:\([0-9a-f]\{8\}\).*/\1/p' AGENTS.md | head -n 1)"
  if [ "$actual" = "$recorded" ]; then
    say "ok    AGENTS.md 入口与 project.yaml 同步（digest: ${actual}）"
  else
    say "FAIL  AGENTS.md 入口已过期（记录: ${recorded:-无} / 实际: ${actual}）"
    say "      → 运行 ./agent-workflow/bin/awf bootstrap"
    fails=$((fails + 1))
  fi

  # F6：生成副本漂移（kit 形态：项目根同时有 bin/awf 与 templates/）
  local drift_out drift_n
  drift_out="$(copy_drift_report "$root" || true)"
  drift_n="$(printf '%s\n' "$drift_out" | grep -c '^FAIL' || true)"
  [ "$drift_n" -gt 0 ] && fails=$((fails + drift_n))
  printf '%s\n' "$drift_out" | grep -v '^$' || true

  # F3：current.md 与 done.md 归档块/归档行同解析
  for f in agent-workflow/tasks/dev/current.md agent-workflow/tasks/debug/current.md agent-workflow/tasks/docs/current.md \
           agent-workflow/tasks/dev/done.md agent-workflow/tasks/debug/done.md agent-workflow/tasks/docs/done.md; do
    [ -f "$f" ] || continue
    case "$f" in
      */dev/*)   t="dev" ;;
      */debug/*) t="debug" ;;
      */docs/*)  t="docs" ;;
    esac
    case "$f" in
      */done.md) m="done" ;;
      *)         m="current" ;;
    esac
    out="$(check_current_file "$f" "$t" "$m")" || true
    if printf '%s' "$out" | grep -q 'FAIL'; then
      fails=$((fails + 1))
    fi
    printf '%s\n' "$out" | grep -v '^$' || true
  done

  # F2：status.md 新鲜度（账本改动后必须 awf status 刷新）
  if out="$(check_status_fresh)"; then
    printf '%s\n' "$out" | grep -v '^$' || true
  else
    fails=$((fails + 1))
    printf '%s\n' "$out" | grep -v '^$' || true
  fi

  if [ "$fails" -eq 0 ]; then
    say ""
    say "全部检查通过"
  else
    say ""
    say "发现 $fails 处问题"
  fi

  # DEV-117：smoke 并入日常门禁——默认只在末尾提示；--with-smoke 实际执行
  if [ -f "test/smoke.sh" ]; then
    say ""
    say "提示：改动/发版后请运行 bash test/smoke.sh，或直接用 awf check --with-smoke 一并执行"
    if [ "$with_smoke" -eq 1 ]; then
      if [ "$fails" -gt 0 ]; then
        say "skip  check 存在 $fails 处问题，跳过 smoke（先修 FAIL 再 --with-smoke）"
      else
        say "== 运行 bash test/smoke.sh（--with-smoke）=="
        local smoke_rc=0
        bash test/smoke.sh || smoke_rc=$?
        if [ "$smoke_rc" -ne 0 ]; then
          say "FAIL  冒烟测试未通过（退出码 ${smoke_rc}）；修复后重跑"
          return 1
        fi
        say ""
        say "ok    smoke 全绿（日常门禁通过）"
      fi
    fi
  elif [ "$with_smoke" -eq 1 ]; then
    say ""
    say "skip  test/smoke.sh 不存在（项目内副本无冒烟测试；kit 形态才可 --with-smoke）"
  fi
  return "$fails"
}

# ---------------------------------------------------------------- status

cmd_status() {
  local root block target f r
  root="$(find_root)" || die "当前目录不在 agent-workflow 项目中"
  cd "$root"

  block="agent-workflow/tasks/status.md.block.tmp"
  target="agent-workflow/tasks/status.md"

  status_build_block "$block"

  if [ ! -f "$target" ]; then
    {
      printf '# 全局状态摘要\n\n'
      printf '<!-- awf:status:begin -->\n'
      cat "$block"
      printf '<!-- awf:status:end -->\n'
    } > "$target"
  elif grep -q 'awf:status:begin' "$target"; then
    awfk -v bf="$block" '
      BEGIN { while ((getline l < bf) > 0) blk = blk l "\n" }
      /<!-- awf:status:begin/ { printf "<!-- awf:status:begin -->\n"; printf "%s", blk; skip = 1; next }
      /<!-- awf:status:end/   { skip = 0; printf "<!-- awf:status:end -->\n"; next }
      !skip { print }
    ' "$target" > "$target.tmp" && mv "$target.tmp" "$target"
  else
    {
      printf '\n<!-- awf:status:begin -->\n'
      cat "$block"
      printf '<!-- awf:status:end -->\n'
    } >> "$target"
  fi

  rm -f "$block"
  say "已更新 $target"
}

# ---------------------------------------------------------------- 发版装配

release_usage() {
  cat <<'EOF'
用法：awf release-prep <X.Y.Z> [--root 目录] [--dry-run]

一键发版装配（在 kit 仓库根运行）：
  0. 检查生成副本漂移（bin/awf / bin/awf-dispatch / templates/ ↔ agent-workflow/），有漂移即拒绝
  1. ./bin/awf init . --force --no-register + bootstrap 刷新生成副本与 AGENTS 入口
  2. 在 agent-workflow/tasks/dev/current.md 写入 release-prep 任务块
  3. 改 VERSION；把 CHANGELOG.md 顶部 ## [Unreleased] 改为 ## [<X.Y.Z>] - 今天
  4. 跑 ./agent-workflow/check_workflow.sh 与 bash test/smoke.sh
  5. ./agent-workflow/bin/awf status 刷新 status.md，并把任务块归档到 done.md
  6. 打印下一步 git add/commit/tag/push 命令与建议 commit 消息

--dry-run   只打印将执行的动作，不改文件、不跑命令
说明：本命令不自动 commit / tag / push；推送必须由用户明确触发。
EOF
}

release_version_ok() {
  case "$1" in
    *[!0-9.]*|.*|*.|*..*|"") return 1 ;;
  esac
  printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
}

release_next_dev_id() {
  local max
  max="$(cat "$ROOT"/agent-workflow/tasks/dev/*.md 2>/dev/null \
    | grep -o 'DEV-[0-9][0-9]*' \
    | sed 's/DEV-//; s/^0*//' \
    | sort -n | tail -n 1 || true)"
  [ -n "$max" ] || max=0
  printf 'DEV-%03d' "$((max + 1))"
}

release_current_id() {
  [ -f "$CURRENT" ] || return 0
  awfk -v ver="$VERSION" '
    index($0, "## [") == 1 && index($0, "release-prep " ver) > 0 {
      line = substr($0, 5); c = index(line, "] ")
      if (c > 0) { print substr(line, 1, c - 1); exit }
    }
  ' "$CURRENT"
}

release_done_id() {
  [ -f "$DONE" ] || return 0
  awfk -F'|' -v ver="$VERSION" '
    index($0, "release-prep " ver) > 0 && $2 ~ /DEV-/ {
      id = $2; gsub(/^[ \t]+|[ \t]+$/, "", id); print id; exit
    }
  ' "$DONE"
}

release_write_current() {
  if [ ! -f "$CURRENT" ]; then
    printf '# 正在开发\n\n' > "$CURRENT"
  fi
  if grep -q '（暂无进行中任务）' "$CURRENT"; then
    grep -v '（暂无进行中任务）' "$CURRENT" > "$CURRENT.tmp" && mv "$CURRENT.tmp" "$CURRENT"
  fi
  if [ -n "$(release_current_id)" ]; then
    say "账本：复用当前未完成的 $TASK_ID 块"
    return 0
  fi
  {
    printf '\n## [%s] release-prep %s\n\n' "$TASK_ID" "$VERSION"
    printf '| 字段 | 内容 |\n|------|------|\n'
    printf '| 优先级 | P1 |\n'
    printf '| 状态 | active |\n'
    printf '| Owner | agent |\n'
    printf '| 协作模式 | single |\n'
    printf '| 来源任务 | 用户直接触发 |\n'
    printf '| 修改范围 | VERSION / CHANGELOG.md / 生成副本 / 账本 |\n'
    printf '| 分支/工作区 | N/A |\n'
    printf '| 依赖 | 无 |\n'
    printf '| 最近更新 | %s |\n\n' "$(today)"
    printf '### 目标\n一键发版装配 %s。\n\n' "$VERSION"
    printf '### 验收标准\n- [ ] ./agent-workflow/check_workflow.sh 通过\n- [ ] bash test/smoke.sh 通过\n\n'
    printf '### 下一步\n执行 release-prep 打印的 git add/commit/tag/push 命令（由人触发）。\n'
  } >> "$CURRENT"
  say "账本：$CURRENT 写入 ${TASK_ID}（release-prep ${VERSION}）"
}

release_archive() {
  if [ -z "$(release_done_id)" ]; then
    if [ ! -f "$DONE" ]; then
      printf '# 已完成\n\n| 任务ID | 优先级 | 描述 | 完成日期 |\n|--------|--------|------|----------|\n' > "$DONE"
    fi
    printf '| %s | P1 | release-prep %s：一键发版装配 | %s |\n' \
      "$TASK_ID" "$VERSION" "$(today)" >> "$DONE"
    say "账本：已归档 $TASK_ID 到 $DONE"
  else
    say "账本：$DONE 已有 release-prep $VERSION 记录（幂等跳过）"
  fi
  if [ -f "$CURRENT" ]; then
    awfk -v id="$TASK_ID" '
      $0 ~ "^## \\[" id "\\]" { skip = 1; next }
      skip && /^## \[/ { skip = 0 }
      !skip { print }
    ' "$CURRENT" > "$CURRENT.tmp" && mv "$CURRENT.tmp" "$CURRENT"
  fi
}

release_run() {
  say "+ $*"
  ( cd "$ROOT" && "$@" ) || die "步骤失败：$*"
}

cmd_release_prep() {
  local version="" root="" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        [ $# -ge 2 ] || { release_usage >&2; die "缺少 --root 的目录参数"; }
        root="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) release_usage; return 0 ;;
      --*) release_usage >&2; die "未知选项：$1" ;;
      *)
        [ -z "$version" ] || { release_usage >&2; die "只能指定一个版本号"; }
        version="$1"; shift ;;
    esac
  done

  if [ -z "$version" ]; then
    release_usage >&2
    die "缺少版本号（用法：awf release-prep <X.Y.Z>）"
  fi
  if ! release_version_ok "$version"; then
    release_usage >&2
    die "版本号格式错误：${version}（应为 X.Y.Z）"
  fi
  VERSION="$version"

  if [ -n "$root" ]; then
    [ -d "$root" ] || die "目录不存在：$root"
    ROOT="$(cd "$root" && pwd)"
  else
    ROOT="$(find_root)" || die "当前目录不在 agent-workflow 项目中"
  fi
  [ -f "$ROOT/agent-workflow/project.yaml" ] || die "不是 agent-workflow 项目：$ROOT"
  CURRENT="$ROOT/agent-workflow/tasks/dev/current.md"
  DONE="$ROOT/agent-workflow/tasks/dev/done.md"

  TASK_ID="$(release_done_id)"
  if [ -z "$TASK_ID" ]; then
    TASK_ID="$(release_current_id)"
  fi
  if [ -z "$TASK_ID" ]; then
    TASK_ID="$(release_next_dev_id)"
  fi

  if [ "$dry_run" -eq 1 ]; then
    say "[dry-run] cd $ROOT"
    say "[dry-run] 检查生成副本漂移（bin/awf / bin/awf-dispatch / templates/ ↔ agent-workflow/，有漂移即拒绝）"
    say "[dry-run] ./bin/awf init . --force --no-register"
    say "[dry-run] ./bin/awf bootstrap"
    if [ -n "$(release_done_id)" ]; then
      say "[dry-run] 账本：release-prep ${version} 已归档（${TASK_ID}），跳过写入"
    else
      say "[dry-run] 账本：写 $CURRENT 块 [$TASK_ID] release-prep ${version}，校验后归档到 $DONE"
    fi
    say "[dry-run] 写 VERSION=$version"
    if [ -f "$ROOT/CHANGELOG.md" ] && grep -q '^## \[Unreleased\]' "$ROOT/CHANGELOG.md"; then
      say "[dry-run] CHANGELOG: ## [Unreleased] → ## [$version] - $(today)"
    else
      say "[dry-run] CHANGELOG: 未找到 ## [Unreleased]，将提示手动处理"
    fi
    say "[dry-run] ./agent-workflow/check_workflow.sh"
    say "[dry-run] bash test/smoke.sh"
    say "[dry-run] 归档任务块到 done.md"
    say "[dry-run] ./agent-workflow/bin/awf status"
    say "[dry-run] 下一步（不会执行）：git add -A && git commit -m \"release: v${version}（${TASK_ID}）\" && git tag -a v${version} -m \"v${version}\" && git push origin main v$version"
    return 0
  fi

  say "== release-prep ${version}（${TASK_ID}）=="

  # a0. 生成副本漂移保护（F6）：先检测再覆盖，禁止静默回滚 agent-workflow 侧改动
  local drift_out
  drift_out="$(copy_drift_report "$ROOT" || true)"
  if printf '%s\n' "$drift_out" | grep -q '^FAIL'; then
    say ""
    say "== 检测到生成副本漂移，拒绝覆盖 agent-workflow 侧改动 =="
    printf '%s\n' "$drift_out" | grep '^FAIL'
    die "请先同步（或运行 ./bin/awf init . --force --no-register 有意刷新，会覆盖 agent-workflow 侧改动）后再执行 release-prep"
  fi

  # a. 刷新生成副本与 AGENTS 入口
  release_run "$ROOT/bin/awf" init . --force --no-register
  release_run "$ROOT/bin/awf" bootstrap

  # b. 账本（current.md；校验通过后归档）
  if [ -n "$(release_done_id)" ]; then
    say "账本：release-prep ${version} 已归档（${TASK_ID}），跳过写入"
  else
    release_write_current
  fi

  # c. 版本与 CHANGELOG
  if [ ! -f "$ROOT/CHANGELOG.md" ]; then
    die "缺少 CHANGELOG.md，无法更新版本条目（请手动补）"
  fi
  printf '%s\n' "$version" > "$ROOT/VERSION"
  say "已写 VERSION=$version"
  if grep -q '^## \[Unreleased\]' "$ROOT/CHANGELOG.md"; then
    awfk -v ver="$version" -v day="$(today)" '
      !done && /^## \[Unreleased\]/ {
        print "## [" ver "] - " day
        done = 1
        next
      }
      { print }
    ' "$ROOT/CHANGELOG.md" > "$ROOT/CHANGELOG.md.tmp" && mv "$ROOT/CHANGELOG.md.tmp" "$ROOT/CHANGELOG.md"
    say "CHANGELOG：## [Unreleased] → ## [$version] - $(today)"
  elif grep -q "^## \[${version}\]" "$ROOT/CHANGELOG.md"; then
    say "CHANGELOG：已有 ## [$version] 条目（幂等跳过）"
  else
    warn "CHANGELOG 没有 ## [Unreleased]，也没有 ## [$version]；请手动补版本条目"
  fi

  # c2. 账本块刚写入 current.md → 先刷新 status.md，避免「status.md 新鲜度」门禁在 d 误拦截
  #     （F1-F3 门禁加入后 release-prep 的顺序修复；已归档的幂等重跑无需刷新）
  if [ -z "$(release_done_id)" ]; then
    release_run ./agent-workflow/bin/awf status
  fi

  # d. 校验（失败即停，账本保留在 current.md）
  release_run ./agent-workflow/check_workflow.sh
  release_run bash test/smoke.sh

  # e. 先归档再刷新 status，确保 status.md 反映最终状态
  release_archive
  release_run ./agent-workflow/bin/awf status

  # f. 下一步（只提示，不执行）
  say ""
  say "下一步（未自动执行；push 需用户明确触发）："
  say "  git add -A"
  say "  git commit -m \"release: v${version}（${TASK_ID}）\""
  say "  git tag -a v${version} -m \"v${version}\""
  say "  git push origin main v$version"
  say ""
  say "建议 commit 消息：release: v${version}（${TASK_ID}）"
  say "一键命令：git add -A && git commit -m \"release: v${version}（${TASK_ID}）\" && git tag -a v${version} -m \"v${version}\" && git push origin main v$version"
}

# ---------------------------------------------------------------- upgrade

upgrade_usage() {
  cat <<'EOF'
用法：awf upgrade [目录] [--dry-run] [--force]

升级已有项目的 agent-workflow 框架到当前 kit 版本（一等操作，取代“自行推断
拷贝哪些文件”的隐式流程）。在 kit 根目录运行本命令（项目内副本无 templates
源，不能执行 upgrade）：

  1. 复制框架文件到目标 agent-workflow/：
     bin/awf、bin/awf-dispatch、templates/AGENTS.md.tmpl、README.md、
     workflows/*.md、check_workflow.sh 兼容入口（自定义门禁默认保留，见下）
  2. ./agent-workflow/bin/awf bootstrap  刷新 AGENTS.md 受控区块（区块外保留）
  3. ./agent-workflow/bin/awf check      校验（退出码 = 失败项数量）

  保留清单（一律不动）：agent-workflow/project.yaml、tasks/**（账本历史）、
  memory/**、tools/**、AGENTS.md 受控区块外内容。

--dry-run   只打印将变更/保留的文件，不改写任何文件
--force     覆盖目标自定义的 check_workflow.sh（默认：与标准 3 行兼容入口
            不同时保留原文件并告警，避免静默丢失项目自定义门禁）

说明：升级不 bump 版本号、不改写账本内容；旧账本格式问题（归档块缺「状态」
字段、旧英文表头 | Status |）由 check 输出修复指引。只本地 commit，不 push。
EOF
}

cmd_upgrade() {
  local target="." dry_run=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      --force)   force=1; shift ;;
      -h|--help) upgrade_usage; return 0 ;;
      -*)        die "未知参数：$1（用法见 awf upgrade --help）" ;;
      *)         target="$1"; shift ;;
    esac
  done

  # 只有 kit 形态的 awf 才有 templates 源；项目内副本不能当升级源
  if [ ! -f "$TPL_DIR/README.md" ] || [ ! -d "$TPL_DIR/workflows" ]; then
    die "当前 awf 是项目内副本，不能执行 upgrade；请用 kit 根目录的 bin/awf（如 ./bin/awf upgrade <目标项目>）"
  fi

  # 先校验目标确为 agent-workflow 项目，再 mkdir/cd，避免失败残留空目录
  if [ ! -f "$target/agent-workflow/project.yaml" ]; then
    die "目标不是 agent-workflow 项目：${target}（没有 agent-workflow/project.yaml；新项目请用 awf init）"
  fi
  mkdir -p "$target"
  target="$(cd "$target" && pwd)"
  local awf_dir="$target/agent-workflow"

  say "== awf upgrade $target =="

  local item src dst
  # 变更清单：覆盖为 kit 版本（check_workflow.sh 单独处理）
  for item in \
      "bin/awf:$KIT_DIR/bin/awf" \
      "bin/awf-dispatch:$KIT_DIR/bin/awf-dispatch" \
      "templates/AGENTS.md.tmpl:$TPL_DIR/AGENTS.md.tmpl" \
      "templates/pre-commit:$TPL_DIR/pre-commit" \
      "README.md:$TPL_DIR/README.md"; do
    dst="$awf_dir/${item%%:*}"; src="${item#*:}"
    [ -f "$src" ] || continue
    if [ "$dry_run" -eq 1 ]; then
      say "  将覆盖 ${dst}（源 ${src}）"
      continue
    fi
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    case "$item" in bin/*) chmod +x "$dst" ;; esac
  done

  local wf
  for src in "$TPL_DIR"/workflows/*.md; do
    [ -f "$src" ] || continue
    wf="$(basename "$src")"
    if [ "$dry_run" -eq 1 ]; then
      say "  将覆盖 $awf_dir/workflows/${wf}（源 ${src}）"
      continue
    fi
    cp "$src" "$awf_dir/workflows/$wf"
  done

  # check_workflow.sh：标准 3 行兼容入口直接覆盖；自定义门禁默认保留（--force 覆盖）
  local shim="$awf_dir/check_workflow.sh" shim_std shim_cur
  shim_std="$(printf '%s\n' '#!/bin/sh' '# 兼容入口：等价于 agent-workflow/bin/awf check' 'exec "$(dirname "$0")/bin/awf" check "$@"')"
  shim_cur="$(cat "$shim" 2>/dev/null || true)"
  if [ "$shim_cur" != "$shim_std" ] && [ "$force" -eq 0 ]; then
    if [ "$dry_run" -eq 1 ]; then
      say "  将保留 ${shim}（与标准兼容入口不同，疑似项目自定义门禁；--force 才覆盖）"
    else
      warn "check_workflow.sh 与标准兼容入口不同（疑似项目自定义门禁），已保留原文件；确认可替换时用 --force"
    fi
  else
    if [ "$dry_run" -eq 1 ]; then
      say "  将覆盖 ${shim}（标准兼容入口）"
    else
      printf '%s\n' '#!/bin/sh' '# 兼容入口：等价于 agent-workflow/bin/awf check' 'exec "$(dirname "$0")/bin/awf" check "$@"' > "$shim"
      chmod +x "$shim"
    fi
  fi

  if [ "$dry_run" -eq 1 ]; then
    say "  将保留：agent-workflow/project.yaml、tasks/**（账本历史）、memory/**、tools/**、AGENTS.md 区块外内容"
    say "  将运行：$awf_dir/bin/awf bootstrap（刷新 AGENTS.md 入口）"
    say "  将运行：$awf_dir/bin/awf check（校验；退出码 = 失败项数量）"
    return 0
  fi

  say ""
  say "保留：agent-workflow/project.yaml、tasks/**（账本历史）、memory/**、tools/**、AGENTS.md 区块外内容"
  say ""

  ( cd "$target" && "$awf_dir/bin/awf" bootstrap ) || die "bootstrap 失败：$target"
  say "已刷新 AGENTS.md 入口（bootstrap）"

  local rc=0
  ( cd "$target" && "$awf_dir/bin/awf" check ) || rc=$?
  if [ "$rc" -eq 0 ]; then
    say ""
    say "升级完成：${target}（check 全部通过）"
  else
    say ""
    say "升级完成：${target}（check 发现 $rc 处问题，见上方 FAIL；旧账本迁移问题按指引修复后重跑 check）"
  fi
  [ "$shim_cur" != "$shim_std" ] && [ "$force" -eq 0 ] \
    && warn "check_workflow.sh 为项目自定义门禁（未覆盖）；请另行确认其通过"
  say "后续：目标项目只本地 commit（消息含任务 ID），禁止 push"
  if [ -d "$target/.git" ] && [ -f "$awf_dir/templates/pre-commit" ]; then
    say "提示：可用 ./agent-workflow/bin/awf install-hooks 安装 git pre-commit 钩子（提交前自动跑 check，未过即拒绝）"
  fi
  return "$rc"
}

# ---------------------------------------------------------------- install-hooks

install_hooks_usage() {
  cat <<'EOF'
用法：awf install-hooks [--check | --uninstall]

git pre-commit 钩子管理（DEV-117 日常门禁）：提交前自动运行
./agent-workflow/check_workflow.sh，非零即拒绝提交并输出中文提示。

  --check      只检查状态（已安装且一致 / 已安装但过期 / 未安装），不改写任何文件
  --uninstall  删除已安装的钩子
  默认         安装：钩子已与模板一致时跳过，否则覆盖为模板版本

模板来源：kit 根 templates/pre-commit，或项目 agent-workflow/templates/pre-commit
（由 awf upgrade 复制进项目）。需在 git 仓库内的 agent-workflow 项目中执行。
钩子不入库，不影响其他协作者；只检查、不改写文件、不 push。
EOF
}

cmd_install_hooks() {
  local action="install"
  while [ $# -gt 0 ]; do
    case "$1" in
      --check)     action="check"; shift ;;
      --uninstall) action="uninstall"; shift ;;
      -h|--help)   install_hooks_usage; return 0 ;;
      *) die "未知参数：$1（用法见 awf install-hooks --help）" ;;
    esac
  done

  local root tpl hook
  root="$(find_root)" || die "当前目录不在 agent-workflow 项目中（找不到 agent-workflow/project.yaml）"
  [ -d "$root/.git" ] || die "不是 git 仓库：${root}（钩子需要 .git/hooks/pre-commit）"

  tpl="$root/agent-workflow/templates/pre-commit"
  if [ ! -f "$tpl" ] && [ -f "$TPL_DIR/pre-commit" ]; then
    tpl="$TPL_DIR/pre-commit"   # kit 形态兜底（项目副本 upgrade 后通常已有模板）
  fi
  [ -f "$tpl" ] || die "找不到钩子模板：$TPL_DIR/pre-commit（kit）或 agent-workflow/templates/pre-commit（先 awf upgrade）"

  hook="$root/.git/hooks/pre-commit"
  case "$action" in
    check)
      if [ -f "$hook" ] && cmp -s "$hook" "$tpl"; then
        say "ok    钩子已安装且与模板一致：$hook"
      elif [ -f "$hook" ]; then
        say "STALE 钩子存在但与模板不一致：${hook}（重跑 install-hooks 可覆盖为模板版本）"
      else
        say "NONE  未安装钩子：${hook}（运行 awf install-hooks 安装）"
      fi
      return 0
      ;;
    uninstall)
      if [ -f "$hook" ]; then
        rm -f "$hook"
        say "已卸载钩子：$hook"
      else
        say "提示：钩子不存在，无需卸载"
      fi
      return 0
      ;;
  esac

  if [ -f "$hook" ] && cmp -s "$hook" "$tpl"; then
    say "ok    钩子已是最新，跳过安装：$hook"
    return 0
  fi
  mkdir -p "$root/.git/hooks"
  cp "$tpl" "$hook"
  chmod +x "$hook"
  say "已安装钩子：$hook"
  say "效果：git commit 前自动跑 ./agent-workflow/check_workflow.sh，未过即拒绝并提示；确认跳过可用 git commit --no-verify"
}

# ---------------------------------------------------------------- 全局索引

AGENTS_HOME="${DSH_AGENTS_HOME:-$HOME/.agents}"
REGISTRY="$AGENTS_HOME/projects.tsv"
REGISTRY_INDEX="$AGENTS_HOME/AGENTS.md"
# 全局索引写锁（详见 registry_lock）：register / bootstrap 并发时串行化读改写
REGISTRY_LOCK="$AGENTS_HOME/.awf-registry.lock"
REGISTRY_LOCK_MODE=""          # 当前锁类型：flock | mkdir（空 = 未持有）
REGISTRY_LOCK_TRY=100          # 获取锁的重试上限（次）
REGISTRY_LOCK_SLEEP=0.3        # 重试间隔（秒）→ 总等待约 30s
REGISTRY_LOCK_STALE=30         # mkdir 锁陈旧回收阈值（秒）

trim() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

# 文件 mtime（epoch 秒）：Darwin 用 stat -f，其他平台用 stat -c
file_mtime() {
  local out
  if [ "$(uname -s)" = "Darwin" ]; then
    out="$(stat -f %m "$1" 2>/dev/null)" || out=0
  else
    out="$(stat -c %Y "$1" 2>/dev/null)" || out=0
  fi
  [ -n "$out" ] || out=0
  printf '%s' "$out"
}

# 获取全局索引写锁：优先 flock（内核在进程退出时自动释放；Linux 默认路径）。
# 不可用时退化为 mkdir 原子自旋锁（macOS 默认路径），带陈旧锁超时回收
# （持有者超过 REGISTRY_LOCK_STALE 秒未释放视为崩溃，可回收）。
# 持锁期间串行化对 REGISTRY / REGISTRY_INDEX 的全部读改写；进程退出由
# EXIT trap 兜底释放。
registry_lock() {
  mkdir -p "$AGENTS_HOME"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$REGISTRY_LOCK"
    local i=0
    while ! flock -n 9; do
      i=$((i + 1))
      if [ "$i" -ge "$REGISTRY_LOCK_TRY" ]; then
        die "等待全局索引锁超时（flock 重试 ${REGISTRY_LOCK_TRY} 次）：$REGISTRY_LOCK"
      fi
      sleep "$REGISTRY_LOCK_SLEEP"
    done
    REGISTRY_LOCK_MODE=flock
  else
    local i=0
    while ! mkdir "$REGISTRY_LOCK" 2>/dev/null; do
      i=$((i + 1))
      if [ -d "$REGISTRY_LOCK" ]; then
        # 陈旧锁回收：超过阈值视为持有进程已崩溃/挂起，可安全抢占
        if [ "$(($(date +%s) - $(file_mtime "$REGISTRY_LOCK")))" -gt "$REGISTRY_LOCK_STALE" ]; then
          rmdir "$REGISTRY_LOCK" 2>/dev/null || true
          continue
        fi
      fi
      if [ "$i" -ge "$REGISTRY_LOCK_TRY" ]; then
        die "等待全局索引锁超时（mkdir 自旋 ${REGISTRY_LOCK_TRY} 次）：$REGISTRY_LOCK"
      fi
      sleep "$REGISTRY_LOCK_SLEEP"
    done
    REGISTRY_LOCK_MODE=mkdir
  fi
  trap 'registry_unlock' EXIT
}

# 释放全局索引写锁（幂等；进程退出时由 EXIT trap 兜底调用）
registry_unlock() {
  if [ "$REGISTRY_LOCK_MODE" = flock ]; then
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
  elif [ "$REGISTRY_LOCK_MODE" = mkdir ]; then
    rmdir "$REGISTRY_LOCK" 2>/dev/null || true
  fi
  REGISTRY_LOCK_MODE=""
}

# 重建 AGENTS.md 受控区块；write_registration 在持锁状态下调用。
# 独立调用时也会自行取锁，保证该入口同样被串行化保护。
write_registry_index() {
  local block="$AGENTS_HOME/.projects.block.tmp"
  local hold=0
  if [ -z "$REGISTRY_LOCK_MODE" ]; then
    registry_lock
    hold=1
  fi
  mkdir -p "$AGENTS_HOME"
  {
    printf '## 项目索引（awf 生成，勿手改）\n\n'
    printf '| 项目ID | 别名 | 路径 | 入口 |\n'
    printf '|--------|------|------|------|\n'
    while IFS='|' read -r rid ralias rpath rentry; do
      [ -n "$(trim "$rid")" ] || continue
      case "$(trim "$rid")" in \#*) continue ;; esac
      printf '| %s | %s | %s | %s |\n' \
        "$(trim "$rid")" "$(trim "$ralias")" "$(trim "$rpath")" "$(trim "$rentry")"
    done < "$REGISTRY"
    printf '\n## 命中后\n\n'
    printf '1. 切到表中路径，读该仓库的 `AGENTS.md`\n'
    printf '2. 只读定位可直接进行；要写入请把该目录设为会话工作区\n'
    printf '3. 路径或别名变化后，在该项目内重跑 `awf register`\n'
  } > "$block"

  if [ ! -f "$REGISTRY_INDEX" ]; then
    {
      printf '# 全局项目索引\n\n'
      printf '> 由 `awf register` 维护，只放指针，不写项目细节。\n\n'
      printf '<!-- awf:projects:begin -->\n'
      cat "$block"
      printf '<!-- awf:projects:end -->\n'
    } > "$REGISTRY_INDEX"
  elif grep -q 'awf:projects:begin' "$REGISTRY_INDEX"; then
    awfk -v bf="$block" '
      BEGIN { while ((getline l < bf) > 0) blk = blk l "\n" }
      /<!-- awf:projects:begin/ { printf "<!-- awf:projects:begin -->\n"; printf "%s", blk; skip = 1; next }
      /<!-- awf:projects:end/   { skip = 0; printf "<!-- awf:projects:end -->\n"; next }
      !skip { print }
    ' "$REGISTRY_INDEX" > "$REGISTRY_INDEX.tmp" && mv "$REGISTRY_INDEX.tmp" "$REGISTRY_INDEX"
  else
    {
      printf '\n<!-- awf:projects:begin -->\n'
      cat "$block"
      printf '<!-- awf:projects:end -->\n'
    } >> "$REGISTRY_INDEX"
  fi
  rm -f "$block"
  if [ "$hold" -eq 1 ]; then
    registry_unlock
  fi
}

# 使用当前 P_* 与 ${PWD}；调用前必须已 load_project 且 cd 到项目根。
# 全程持锁：锁内重新读取当前 REGISTRY、按 P_ID 合并本行后原子替换，
# 再重建 AGENTS.md 受控区块，杜绝并发 register/bootstrap 的丢失更新。
write_registration() {
  registry_lock
  mkdir -p "$AGENTS_HOME"
  [ -f "$REGISTRY" ] || : > "$REGISTRY"
  grep -v -F "$P_ID |" "$REGISTRY" > "$REGISTRY.tmp" || true
  printf '%s | %s | %s | AGENTS.md\n' "$P_ID" "$P_ALIASES" "$PWD" >> "$REGISTRY.tmp"
  mv "$REGISTRY.tmp" "$REGISTRY"
  write_registry_index
  registry_unlock
}

is_registered() {
  [ -f "$REGISTRY" ] && grep -F -q "$P_ID |" "$REGISTRY"
}

cmd_register() {
  local root role
  root="$(find_root)" || die "当前目录不在 agent-workflow 项目中"
  cd "$root"
  load_project "agent-workflow/project.yaml"

  write_registration
  say "已登记：$P_ID → $root"
  say "全局索引：$REGISTRY_INDEX"
  role="$(yaml_get role "agent-workflow/project.yaml")"
  if [ -n "$role" ]; then
    say "已登记 worker 名牌：$role"
  else
    say "提示：可在此项目 project.yaml 添加 role 字段作为 worker 名牌（一句话自述；router 检索工作群时可见）"
  fi
}

cmd_projects() {
  [ -f "$REGISTRY" ] || die "尚未登记任何项目（在项目内运行 ./agent-workflow/bin/awf register）"
  printf '| 项目ID | 别名 | 路径 | 角色 |\n|--------|------|------|------|\n'
  local rid ralias rpath rentry rp role
  while IFS='|' read -r rid ralias rpath rentry; do
    [ -n "$(trim "$rid")" ] || continue
    case "$(trim "$rid")" in \#*) continue ;; esac
    rp="$(trim "$rpath")"
    role="$(project_role "$rp")"
    printf '| %s | %s | %s | %s |\n' "$(trim "$rid")" "$(trim "$ralias")" "$rp" "$role"
  done < "$REGISTRY"
}

cmd_find() {
  local q="${1:-}"
  [ -n "$q" ] || die "用法：awf find <别名|ID>"
  [ -f "$REGISTRY" ] || die "尚未登记任何项目"
  local hits
  hits="$(grep -i -- "$q" "$REGISTRY" || true)"
  if [ -z "$hits" ]; then
    say "未找到：$q"
    return 1
  fi
  # 输出 `id\t路径\t角色`：role 读目标项目 project.yaml（yaml 为单一事实源，
  # 手动加 role 立即生效，无需 re-register）；缺省回退 name，再缺省 `-`。
  local rid ralias rpath rentry role
  printf '%s\n' "$hits" | while IFS='|' read -r rid ralias rpath rentry; do
    rid="$(trim "$rid")"
    [ -n "$rid" ] || continue
    role="$(project_role "$(trim "$rpath")")"
    printf '%s\t%s\t%s\n' "$rid" "$(trim "$rpath")" "$role"
  done
}

# ---------------------------------------------------------------- main

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift || true

  case "$cmd" in
    init)      cmd_init "$@" ;;
    bootstrap) cmd_bootstrap ;;
    check)     cmd_check "$@" ;;
    status)    cmd_status ;;
    register)  cmd_register ;;
    projects)  cmd_projects ;;
    find)      cmd_find "$@" ;;
    release-prep) cmd_release_prep "$@" ;;
    upgrade)     cmd_upgrade "$@" ;;
    install-hooks) cmd_install_hooks "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "未知命令：${cmd}（可用：init / bootstrap / check / status / register / projects / find / release-prep / upgrade / install-hooks）" ;;
  esac
}

main "$@"
