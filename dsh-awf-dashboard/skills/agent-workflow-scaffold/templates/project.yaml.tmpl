# agent-workflow 项目事实（唯一输入）
#
# 改完这里运行：~/.agents/skills/agent-workflow-scaffold/bin/awf bootstrap
# 说明：只使用扁平 `key: value`，列表字段写成逗号分隔的单行字符串，
#       这样无需 YAML 解析器也能被 awf 与任意 shell 稳定读取。

version: {{VERSION}}
id: {{ID}}
name: {{NAME}}
purpose: {{PURPOSE}}
aliases: {{ALIASES}}
stack: {{STACK}}

# role: worker 名牌（能力自述一句话，router 检索时可见；可选，不填则 find/projects 回退 name）
# 填写示例：role: 负责生成/校验 agent 工作流脚手架，管理任务账本
role: {{ROLE}}

# 校验命令（留空表示暂未配置）
gate: {{GATE}}
compile: {{COMPILE}}
test: {{TEST}}

# 并行切分：格式为 “名称(路径), 名称(路径)”
scopes: {{SCOPES}}

# 并行时任何单元都不许同时修改的文件或目录
serialized: {{SERIALIZED}}

# 发版落点（可选键：不写某个键即回退到默认值；流程见 release 技能 skills/release/SKILL.md）
# version_file: 版本号所在文件，单行 semver；默认 VERSION。
#               语言生态有原生版本字段（package.json / pyproject.toml / Cargo.toml）时指向它，只改一处。
#               锚点位置铁律（DEV-198 / SP-302）：Unity/C++ 项目勿放项目根 VERSION——macOS 大小写
#               不敏感 FS 上根 VERSION 会遮蔽 libc++ <version> 头（clang -I"." 全量构建报
#               expected unqualified-id），一律指向 agent-workflow/VERSION（git mv VERSION
#               agent-workflow/VERSION 后设本键）；纯脚本/文档项目可保持默认。
# changelog:    变更记录文件；默认 CHANGELOG.md。
# tag_prefix:   发版 tag 前缀；默认 v（tag 形如 v1.2.3）。
# 双版本模型（DEV-205）：技能版 = version_file 锚点（每次发版 bump，插件显示、技能实体安装消费）；
# 骨架版 = 固定 agent-workflow/FRAMEWORK_VERSION（仅骨架契约 bin/awf、AGENTS.md.tmpl、账本结构、
# check 门禁等变化时 bump；awf upgrade 判定与插件 outdated 消费）。FRAMEWORK_VERSION 勿放项目根
# （与锚点铁律同位置规范），由 init/upgrade 自动登记，不进 project.yaml 键、不走 version_file。
version_file: VERSION
changelog: CHANGELOG.md
tag_prefix: v

# 项目本地技能目录：每个技能一个 <name>/SKILL.md，全局技能优先读取这里
# （有本地技能时不走全局技能默认流程）。改目录位置时同步本键。
local_skills: agent-workflow/skills/
